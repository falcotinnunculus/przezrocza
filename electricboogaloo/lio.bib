 @article{Aghion_Ahlén_Amsler_Ariga_Ariga_Belov_Berggren_Bonomi_Bräunig_Bremer_etal._2014, title={A moiré deflectometer for antimatter}, volume={5}, ISSN={2041-1723}, url={https://www.nature.com/articles/ncomms5538}, DOI={10.1038/ncomms5538}, abstractNote={The precise measurement of forces is one way to obtain deep insight into the fundamental interactions present in nature. In the context of neutral antimatter, the gravitational interaction is of high interest, potentially revealing new forces that violate the weak equivalence principle. Here we report on a successful extension of a tool from atom optics—the moiré deflectometer—for a measurement of the acceleration of slow antiprotons. The setup consists of two identical transmission gratings and a spatially resolving emulsion detector for antiproton annihilations. Absolute referencing of the observed antimatter pattern with a photon pattern experiencing no deflection allows the direct inference of forces present. The concept is also straightforwardly applicable to antihydrogen measurements as pursued by the AEgIS collaboration. The combination of these very different techniques from high energy and atomic physics opens a very promising route to the direct detection of the gravitational acceleration of neutral antimatter.}, number={1}, journal={Nature Communications}, author={Aghion, S. and Ahlén, O. and Amsler, C. and Ariga, A. and Ariga, T. and Belov, A. S. and Berggren, K. and Bonomi, G. and Bräunig, P. and Bremer, J. and Brusa, R. S. and Cabaret, L. and Canali, C. and Caravita, R. and Castelli, F. and Cerchiari, G. and Cialdi, S. and Comparat, D. and Consolati, G. and Derking, H. and Di Domizio, S. and Di Noto, L. and Doser, M. and Dudarev, A. and Ereditato, A. and Ferragut, R. and Fontana, A. and Genova, P. and Giammarchi, M. and Gligorova, A. and Gninenko, S. N. and Haider, S. and Huse, T. and Jordan, E. and Jørgensen, L. V. and Kaltenbacher, T. and Kawada, J. and Kellerbauer, A. and Kimura, M. and Knecht, A. and Krasnický, D. and Lagomarsino, V. and Lehner, S. and Magnani, A. and Malbrunot, C. and Mariazzi, S. and Matveev, V. A. and Moia, F. and Nebbia, G. and Nédélec, P. and Oberthaler, M. K. and Pacifico, N. and Petràček, V. and Pistillo, C. and Prelz, F. and Prevedelli, M. and Regenfus, C. and Riccardi, C. and Røhne, O. and Rotondi, A. and Sandaker, H. and Scampoli, P. and Storey, J. and Vasquez, M.A. Subieta and Špaček, M. and Testera, G. and Vaccarone, R. and Widmann, E. and Zavatarelli, S. and Zmeskal, J.}, year={2014}, month=july, pages={4538}, language={en} }
