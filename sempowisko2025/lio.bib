@misc{Alicja_2021, title={How to build a turnstile antenna for 435Mhz (and connect it to SatNOGS network) - tutorial for beginners | alicja.space}, url={https://alicja.space/blog/how-to-build-turnstile-antenna/}, abstractNote={Today we are all here to talk about the most intriguing topic in the world. About the invisible force that is always around us... About the energy that lets us communicate on ridiculously long distances using just a metal stick… About the magical steam without which any space mission would not be possible... Radio waves! In the first part of this article you can find a tutorial how to build your turnstile antenna for 435.500 Mhz, while in the second part we will answer the most important question: why should you even build an antenna. Enjoy!}, author={Alicja, Musiał}, year={2021}, month=apr, language={en} }
