  doi          = {10.1126/science.6987736},
  abstractnote = {When tissue cells are cultured on very thin sheets of cross-linked silicone fluid, the traction forces the cells exert are made visible as elastic distortion and wrinkling of this substratum. Around explants this pattern of wrinkling closely resembles the “center effects” long observed in plasma clots and traditionally attributed to dehydration shrinkage.},
  number       = {4440},
